# =============================================================================
# DeckSupreme — environment template
# -----------------------------------------------------------------------------
# Copy to .env (`make env` does this and generates the secrets for you).
# NEVER commit .env. Use URL-safe characters in passwords (no @ : / # % ?).
# =============================================================================

# --- Clash Royale API ---------------------------------------------------------
# Create at https://developer.clashroyale.com. Keys are bound to the public IP
# address(es) you whitelist; containers egress through your host's public IP.
CLASH_ROYALE_API_KEY=

# --- PostgreSQL (data warehouse) ---------------------------------------------
POSTGRES_USER=decksupreme
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=decksupreme
# Port published on the HOST. Containers always talk to postgres:5432.
POSTGRES_PORT=5432

# --- MinIO (raw data lake) ----------------------------------------------------
MINIO_ROOT_USER=decksupreme
MINIO_ROOT_PASSWORD=change-me-minio-min8chars
# Endpoint as seen from the HOST (scripts/tests). Containers use http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=decksupreme-raw

# --- GitHub publishing --------------------------------------------------------
# Fine-grained PAT scoped to GITHUB_REPO with "Contents: Read and write" only.
GITHUB_TOKEN=
# owner/repo, e.g. aravdewan/decksupreme
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Scoring (optional; defaults shown) -----------------------------------------
# Feature weights: win rate, usage rate, attack/elixir, defense/elixir, speed. Sum = 1.
# SCORING_WEIGHTS=wr=0.35,ur=0.25,ape=0.15,dpe=0.15,ss=0.10
# Cards with fewer deck appearances than this in the week are left unranked.
# SCORING_MIN_MATCHES=1

# =============================================================================
# Infrastructure settings (Airflow + ports). Defaults are fine for local dev.
# =============================================================================

# Airflow metadata DB — a separate database/role on the same Postgres server,
# created automatically on first boot by docker/postgres/init/.
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_DB_NAME=airflow

# Airflow UI login (created by airflow-init).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Generate with `make env`, or:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=

# Linux: set to `id -u` so files Airflow writes to ./rankings are owned by you.
# macOS/Windows: leave at 50000.
AIRFLOW_UID=50000

# Host ports
AIRFLOW_WEBSERVER_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
